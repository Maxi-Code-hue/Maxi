# Public base URL used to build magic links
APP_URL=http://localhost:3000

# Magic-link token lifetime in minutes
AUTH_TOKEN_TTL_MINUTES=15

# Session lifetime in days
SESSION_TTL_DAYS=30

# --- Optional: real email delivery (Resend) ---
# If unset, magic links are logged to the server console and (in dev) shown in the UI.
# RESEND_API_KEY=
# EMAIL_FROM=Maxi Coffee <login@yourdomain.com>
